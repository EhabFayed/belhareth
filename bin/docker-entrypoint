#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# If starting the rails server (however it is invoked — directly or via
# `bash -c "... bin/rails server ..."` as docker-compose does), create or
# migrate the database first so deploys never boot against a stale schema.
if echo "$*" | grep -q "rails server"; then
  ./bin/rails db:prepare
fi

exec "${@}"
