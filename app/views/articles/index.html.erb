<% content_for :title, rtl? ? "المقالات والمحتوى التوعوي" : "Articles & Patient Education" %>
<% content_for :meta_description, t("articles.intro") %>

<div>
  <div class="sec-pad" style="padding:80px 48px 56px;background:radial-gradient(110% 85% at 88% 0%,#E4F0F9 0%,rgba(228,240,249,0) 58%),linear-gradient(180deg,#FDFEFF 0%,#F7FAFC 100%)">
    <div style="display:flex;align-items:center;gap:12px;animation:fadeUp .7s .1s ease both"><svg width="64" height="22" viewBox="0 0 64 22" style="overflow:visible;flex:none"><path d="M0 11 H14 L19 3 L25 19 L30 11 H64" fill="none" stroke="#1273BF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="110" stroke-dashoffset="110" style="animation:ecg 2.8s linear infinite"></path></svg><span style="font-size:12px;letter-spacing:.24em;color:#1273BF"><%= t("articles.eyebrow") %></span></div>
    <h1 style="margin:22px 0 0;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(36px,4.8vw,62px);line-height:1;text-transform:uppercase;animation:fadeUp .7s .25s ease both"><%= t("articles.heading_html") %></h1>
    <p style="margin:24px 0 0;max-width:560px;font-size:16px;line-height:1.7;color:rgba(22,40,58,.65);animation:fadeUp .7s .4s ease both"><%= t("articles.intro") %></p>
  </div>
  <div class="sec-pad" style="padding:0 48px 88px">
    <div style="display:flex;gap:10px;margin-bottom:32px;font-size:12.5px;letter-spacing:.1em;flex-wrap:wrap">
      <a href="<%= articles_path %>" class="chip <%= 'chip-on' unless @category %>"><%= t("articles.all") %></a>
      <% ArticlesController::CATEGORIES.each do |cat| %>
        <a href="<%= articles_path(category: cat) %>" class="chip <%= 'chip-on' if @category == cat %>"><%= t("articles.categories.#{cat}") %></a>
      <% end %>
    </div>
    <% if @blogs.any? %>
    <div class="rv-kids m2" style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px">
      <% @blogs.each do |blog| %>
      <a href="<%= article_path(loc_slug(blog)) %>" class="card-line" style="border:1px solid rgba(22,40,58,.1);border-radius:18px;overflow:hidden;background:#fff;box-shadow:0 2px 10px rgba(22,40,58,.04);display:block;transition:border-color .3s,transform .3s">
        <% if (photo_url = blog_photo_url(blog)) %>
          <div style="height:170px"><img class="slot" src="<%= photo_url %>" alt="<%= loc(blog, :image_alt_text).presence || loc(blog, :title) %>" style="height:170px;border-radius:0"></div>
        <% end %>
        <div style="padding:22px 24px">
          <div style="font-size:11.5px;letter-spacing:.18em;color:#1273BF;margin-bottom:10px"><%= blog.category ? t("articles.categories.#{blog.category}", default: blog.category.to_s.upcase) : t("articles.categories.general") %></div>
          <div style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:18px;line-height:1.35;color:#16283A"><%= loc(blog, :title) %></div>
          <% if loc(blog, :description).present? %>
            <div style="margin-top:12px;font-size:13.5px;line-height:1.6;color:rgba(22,40,58,.55)"><%= loc(blog, :description) %></div>
          <% end %>
        </div>
      </a>
      <% end %>
    </div>
    <% else %>
    <div style="border:1px dashed rgba(22,40,58,.25);border-radius:18px;padding:60px 40px;text-align:center;color:rgba(22,40,58,.55);font-size:15px">
      <%= t("articles.empty_html", contact: contact_path) %>
    </div>
    <% end %>
  </div>

  <%= render "shared/cta_band", headline_html: t("condition.cta_html"), whatsapp: true %>
</div>
