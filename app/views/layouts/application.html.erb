<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= rtl? ? 'rtl' : 'ltr' %>">
<head>
  <!-- Google Tag Manager -->
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-TDB6ZWSZ');</script>
  <!-- End Google Tag Manager -->
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= page_title %></title>
  <% if content_for?(:meta_description) %><meta name="description" content="<%= content_for(:meta_description) %>"><% end %>
  <link rel="canonical" href="<%= canonical_url %>">
  <link rel="alternate" hreflang="en" href="<%= alternate_url(:en) %>">
  <link rel="alternate" hreflang="ar" href="<%= alternate_url(:ar) %>">
  <%= csrf_meta_tags %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <% if rtl? %>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <% else %>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Figtree:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <% end %>
  <link rel="stylesheet" href="/site.css">
  <script src="/site.js" defer></script>
</head>
<body>
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TDB6ZWSZ"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
<div style="background:#F7FAFC;color:#16283A;font-family:'Figtree',sans-serif;min-height:100vh">

  <% if notice || alert %>
    <div class="toast <%= alert ? 'toast-err' : '' %>" id="site-toast"><%= notice || alert %></div>
  <% end %>

  <%= yield :splash %>

  <%= render "shared/nav" %>

  <%= yield %>

  <%= render "shared/whatsapp_float" %>
  <%= render "shared/footer" %>
</div>
</body>
</html>
