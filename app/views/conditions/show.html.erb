<% content_for :title, (rtl? ? @operation.meta_title_ar.presence : @operation.meta_title_en.presence) || loc(@operation, :title) %>
<% content_for :meta_description, (rtl? ? @operation.meta_description_ar.presence : @operation.meta_description_en.presence) || loc(@operation, :description) %>
<% content_for :alternate_en, "#{request.base_url}/specialties/#{@operation.slug}" %>
<% content_for :alternate_ar, "#{request.base_url}/ar/specialties/#{ERB::Util.url_encode(@operation.slug_ar.presence || @operation.slug)}" %>

<div>
  <div class="sec-pad" style="padding:64px 48px 56px;background:radial-gradient(110% 85% at 88% 0%,#E4F0F9 0%,rgba(228,240,249,0) 58%),linear-gradient(180deg,#FDFEFF 0%,#F7FAFC 100%)">
    <div style="display:flex;gap:10px;font-size:12px;letter-spacing:.14em;color:rgba(22,40,58,.5)">
      <a href="<%= root_path %>" class="link-blue"><%= t("common.breadcrumb_home") %></a><span>/</span>
      <a href="<%= specialties_path %>" class="link-blue"><%= t("common.breadcrumb_specialties") %></a><span>/</span>
      <span style="color:#1273BF"><%= loc(@operation, :title).upcase %></span>
    </div>
    <div class="m1" style="display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:56px;align-items:center;margin-top:36px">
      <div style="display:flex;flex-direction:column;gap:24px">
        <span style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:20px;color:rgba(22,40,58,.35)"><%= format('%02d', @position) %></span>
        <h1 style="margin:0;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(28px,3.6vw,58px);line-height:1.15;text-transform:uppercase;color:#1273BF;overflow-wrap:anywhere"><%= loc(@operation, :title) %></h1>
        <p style="margin:0;font-size:17px;line-height:1.75;color:rgba(22,40,58,.72);max-width:540px"><%= loc(@operation, :description) %></p>
        <div style="display:flex;flex-wrap:wrap;gap:14px">
          <a href="<%= contact_path %>" class="btn-blue" style="padding:16px 32px;border-radius:999px;background:#1273BF;color:#fff;font-size:14px;font-weight:700;letter-spacing:.06em;transition:background .3s"><%= t("common.book_assessment") %></a>
          <a href="<%= ApplicationHelper::CLINIC_WHATSAPP_URL %>" target="_blank" rel="noopener" class="btn-wa-outline" style="padding:16px 32px;border-radius:999px;border:1px solid #25D366;color:#128C4B;font-size:14px;font-weight:700;letter-spacing:.06em;transition:background .3s,color .3s"><%= t("common.ask_whatsapp") %></a>
        </div>
      </div>
      <% if (photo_url = operation_photo_url(@operation, landing: false)) %>
      <div style="position:relative">
        <div style="width:100%;height:400px"><img class="slot" src="<%= photo_url %>" alt="<%= loc(@operation, :image_alt_text).presence || loc(@operation, :title) %>" style="border-radius:18px;height:400px"></div>
      </div>
      <% end %>
    </div>
  </div>

  <div style="border-top:1px solid rgba(22,40,58,.12);padding-top:56px"></div>

  <%= render "shared/rich_contents", contents: @operation.contents.where(is_deleted: false, is_published: true).order(:id) %>

  <% faqs = @operation.faqs.where(is_deleted: false, is_published: true).order(:id) %>
  <% if faqs.any? %>
  <div class="rv m1 sec-pad" style="padding:0 48px 80px;display:grid;grid-template-columns:minmax(0,.4fr) minmax(0,.6fr);gap:56px">
    <div>
      <div style="font-size:12px;letter-spacing:.24em;color:#1273BF;margin-bottom:18px"><%= t("condition.faq_label") %></div>
      <h2 style="margin:0;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:38px;line-height:1.05;text-transform:uppercase"><%= t("condition.faq_heading_html") %></h2>
    </div>
    <div style="display:flex;flex-direction:column;gap:14px">
      <% faqs.each do |faq| %>
        <%= render "shared/faq_item", q: loc(faq, :question), a: loc(faq, :answer) %>
      <% end %>
    </div>
  </div>
  <% end %>

  <%= render "shared/cta_band", headline_html: t("condition.cta_html"), whatsapp: true %>
</div>
