<% content_for :title, "Blogs" %>
<div class="adm-head">
  <h1 class="adm-title">Blogs</h1>
  <a href="<%= new_admin_blog_path %>" class="btn">+ New blog</a>
</div>

<table class="adm">
  <tr><th>Title</th><th>Category</th><th>Slug</th><th>Status</th><th></th></tr>
  <% @blogs.each do |blog| %>
  <tr>
    <td><b><%= blog.title_en %></b><br><span class="ar" style="color:rgba(22,40,58,.55)"><%= blog.title_ar %></span></td>
    <td><%= blog.category&.text %></td>
    <td><code><%= blog.slug %></code></td>
    <td><span class="badge <%= blog.is_published ? 'pub' : 'draft' %>"><%= blog.is_published ? 'Published' : 'Draft' %></span></td>
    <td class="inline-actions">
      <a href="<%= edit_admin_blog_path(blog) %>" class="btn sm ghost">Edit</a>
      <% if blog.is_published %>
        <a href="<%= article_path(blog.slug) %>" target="_blank">View ↗</a>
      <% end %>
      <%= button_to "Delete", admin_blog_path(blog), method: :delete, form: { onsubmit: "return confirm('Delete this blog?')" }, class: "btn sm danger" %>
    </td>
  </tr>
  <% end %>
  <% if @blogs.empty? %>
  <tr><td colspan="5" style="text-align:center;color:rgba(22,40,58,.5);padding:34px">No blogs yet — create the first one.</td></tr>
  <% end %>
</table>
