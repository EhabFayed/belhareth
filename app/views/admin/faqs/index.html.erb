<% content_for :title, "FAQs" %>
<div class="adm-head">
  <h1 class="adm-title">Global FAQs</h1>
</div>
<p style="color:rgba(22,40,58,.55);margin:0 0 18px">These appear on the site's <a href="<%= faq_path %>" target="_blank">/faq page</a>. FAQs for a specific blog or operation are managed on that item's edit page.</p>

<% @faqs.each do |faq| %>
  <details class="adm-acc">
    <summary>
      <span><%= faq.question_en.to_s.truncate(90) %></span>
      <span class="badge <%= faq.is_published ? 'pub' : 'draft' %>"><%= faq.is_published ? 'Published' : 'Draft' %></span>
    </summary>
    <div>
      <%= form_with model: [:admin, faq], class: "adm" do |f| %>
        <div class="row">
          <div><label>Question (EN)</label><%= f.text_field :question_en %></div>
          <div><label>Question (AR)</label><%= f.text_field :question_ar, dir: "rtl", class: "ar" %></div>
        </div>
        <div class="row">
          <div><label>Answer (EN)</label><%= f.text_area :answer_en, rows: 4 %></div>
          <div><label>Answer (AR)</label><%= f.text_area :answer_ar, rows: 4, dir: "rtl", class: "ar" %></div>
        </div>
        <div class="row">
          <div class="check"><%= f.check_box :is_published %> <label style="margin:0;text-transform:none">Published</label></div>
        </div>
        <%= f.submit "Save FAQ", class: "btn sm" %>
      <% end %>
      <%= button_to "Delete FAQ", admin_faq_path(faq), method: :delete, form: { onsubmit: "return confirm('Delete this FAQ?')", style: "margin-top:10px" }, class: "btn sm danger" %>
    </div>
  </details>
<% end %>

<details class="adm-acc" open>
  <summary><span style="color:#1273BF">+ Add global FAQ</span></summary>
  <div>
    <%= form_with model: [:admin, @faq], class: "adm" do |f| %>
      <div class="row">
        <div><label>Question (EN)</label><%= f.text_field :question_en %></div>
        <div><label>Question (AR)</label><%= f.text_field :question_ar, dir: "rtl", class: "ar" %></div>
      </div>
      <div class="row">
        <div><label>Answer (EN)</label><%= f.text_area :answer_en, rows: 4 %></div>
        <div><label>Answer (AR)</label><%= f.text_area :answer_ar, rows: 4, dir: "rtl", class: "ar" %></div>
      </div>
      <div class="row">
        <div class="check"><%= f.check_box :is_published, {}, "true", "false" %> <label style="margin:0;text-transform:none">Publish immediately</label></div>
      </div>
      <%= f.submit "Add FAQ", class: "btn sm" %>
    <% end %>
  </div>
</details>
