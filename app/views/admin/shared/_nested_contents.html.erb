<%# locals: parent — Blog or Operation %>
<h2 class="adm-sub">Content blocks</h2>
<p style="color:rgba(22,40,58,.55);margin:0 0 14px">Each block is one section of the page: formatted text (use the editor toolbar for headings, bold, lists and links) plus optional photos shown under the text.</p>

<% parent.contents.where(is_deleted: false).order(:id).each do |content| %>
  <details class="adm-acc">
    <summary>
      <span><%= strip_tags(content.content_en.to_s).truncate(80) %><% if content.content_photos.any? %> <span style="color:#1273BF">📷 <%= content.content_photos.size %></span><% end %></span>
    </summary>
    <div>
      <%= form_with model: [:admin, parent, content], class: "adm" do |f| %>
        <div class="row">
          <%= render "admin/shared/rte", f: f, attr: :content_en, label: "Content (English)", dir: "ltr", value: content.content_en %>
          <%= render "admin/shared/rte", f: f, attr: :content_ar, label: "Content (Arabic)", dir: "rtl", value: content.content_ar %>
        </div>

        <label style="margin-top:6px">Photos in this block</label>
        <% content.content_photos.each do |photo| %>
          <%= f.fields_for :content_photos, photo do |pf| %>
            <div class="photo-row">
              <% if photo.photo.attached? %><img src="<%= url_for(photo.photo) %>" alt=""><% end %>
              <div><label>Alt (EN)</label><%= pf.text_field :alt_en %></div>
              <div><label>Alt (AR)</label><%= pf.text_field :alt_ar, dir: "rtl", class: "ar" %></div>
              <div class="check"><%= pf.check_box :_destroy %> <label style="margin:0;text-transform:none;color:#A02020">Remove</label></div>
            </div>
          <% end %>
        <% end %>
        <%= f.fields_for :content_photos, content.content_photos.build do |pf| %>
          <div class="photo-row">
            <div><label>Add photo</label><%= pf.file_field :photo %></div>
            <div><label>Alt (EN)</label><%= pf.text_field :alt_en %></div>
            <div><label>Alt (AR)</label><%= pf.text_field :alt_ar, dir: "rtl", class: "ar" %></div>
          </div>
        <% end %>

        <div class="inline-actions" style="margin-top:12px">
          <%= f.submit "Save block", class: "btn sm" %>
        </div>
      <% end %>
      <%= button_to "Delete block", [:admin, parent, content], method: :delete, form: { onsubmit: "return confirm('Delete this content block?')", style: "margin-top:10px" }, class: "btn sm danger" %>
    </div>
  </details>
<% end %>

<details class="adm-acc" <%= "open" if parent.contents.where(is_deleted: false).none? %>>
  <summary><span style="color:#1273BF">+ Add content block</span></summary>
  <div>
    <%= form_with model: [:admin, parent, Content.new], class: "adm" do |f| %>
      <div class="row">
        <%= render "admin/shared/rte", f: f, attr: :content_en, label: "Content (English)", dir: "ltr", value: "" %>
        <%= render "admin/shared/rte", f: f, attr: :content_ar, label: "Content (Arabic)", dir: "rtl", value: "" %>
      </div>
      <%= f.fields_for :content_photos, ContentPhoto.new do |pf| %>
        <div class="photo-row">
          <div><label>Photo (optional)</label><%= pf.file_field :photo %></div>
          <div><label>Alt (EN)</label><%= pf.text_field :alt_en %></div>
          <div><label>Alt (AR)</label><%= pf.text_field :alt_ar, dir: "rtl", class: "ar" %></div>
        </div>
      <% end %>
      <%= f.submit "Add block", class: "btn sm", style: "margin-top:12px" %>
    <% end %>
  </div>
</details>
