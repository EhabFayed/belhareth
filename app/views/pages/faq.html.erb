<% content_for :title, rtl? ? "الأسئلة الشائعة" : "Frequently Asked Questions" %>
<% content_for :meta_description, t("faq_page.intro").truncate(200) %>

<div>
  <div class="sec-pad" style="padding:80px 48px 56px;background:radial-gradient(110% 85% at 88% 0%,#E4F0F9 0%,rgba(228,240,249,0) 58%),linear-gradient(180deg,#FDFEFF 0%,#F7FAFC 100%)">
    <div style="display:flex;align-items:center;gap:12px;animation:fadeUp .7s .1s ease both"><svg width="64" height="22" viewBox="0 0 64 22" style="overflow:visible;flex:none"><path d="M0 11 H14 L19 3 L25 19 L30 11 H64" fill="none" stroke="#1273BF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="110" stroke-dashoffset="110" style="animation:ecg 2.8s linear infinite"></path></svg><span style="font-size:12px;letter-spacing:.24em;color:#1273BF"><%= t("faq_page.eyebrow") %></span></div>
    <h1 style="margin:22px 0 0;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(36px,4.8vw,62px);line-height:1.1;text-transform:uppercase;animation:fadeUp .7s .25s ease both"><%= t("faq_page.heading_html") %></h1>
    <p style="margin:24px 0 0;max-width:560px;font-size:16px;line-height:1.7;color:rgba(22,40,58,.65);animation:fadeUp .7s .4s ease both"><%= t("faq_page.intro") %></p>
  </div>

  <div class="rv m1 sec-pad" style="padding:0 48px 80px;display:grid;grid-template-columns:minmax(0,.4fr) minmax(0,.6fr);gap:56px">
    <div>
      <div style="font-size:12px;letter-spacing:.24em;color:#1273BF;margin-bottom:18px"><%= t("faq_page.group_label") %></div>
      <h2 style="margin:0;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(28px,3.2vw,40px);line-height:1.1;text-transform:uppercase"><%= t("faq_page.group_heading_html") %></h2>
      <p style="margin:22px 0 0;font-size:14.5px;line-height:1.7;color:rgba(22,40,58,.6)"><%= t("faq_page.group_note") %></p>
    </div>
    <div style="display:flex;flex-direction:column;gap:14px">
      <% @faqs.each do |faq| %>
        <%= render "shared/faq_item", q: loc(faq, :question), a: loc(faq, :answer) %>
      <% end %>
      <% if @faqs.empty? %>
        <div style="border:1px dashed rgba(22,40,58,.25);border-radius:18px;padding:48px 40px;text-align:center;color:rgba(22,40,58,.55);font-size:15px">
          <%= t("faq_page.empty_html", wa: ApplicationHelper::CLINIC_WHATSAPP_URL) %>
        </div>
      <% end %>
    </div>
  </div>

  <%= render "shared/cta_band", headline_html: t("faq_page.cta_html"), whatsapp: true %>
</div>
