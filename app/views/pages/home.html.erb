<% content_for :meta_description, t("meta.home_description") %>

<% content_for :splash do %>
<div class="splash" id="splash">
  <svg width="220" height="60" viewBox="0 0 220 60" style="overflow:visible"><path d="M0 30 H60 L78 10 L98 50 L114 30 H220" fill="none" stroke="#6FB4E4" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="320" stroke-dashoffset="320" style="animation:ecg 2.2s linear infinite"></path></svg>
  <div style="display:flex;flex-direction:column;align-items:center;gap:12px;animation:splashUp .8s .2s ease both">
    <span style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:28px;letter-spacing:.06em;color:#fff">BALHARETH<span style="color:#6FB4E4">.</span>ORTHO</span>
    <span style="font-size:12px;letter-spacing:.28em;color:rgba(255,255,255,.55)"><%= t("common.splash_tag") %></span>
  </div>
  <div style="width:180px;height:2px;background:rgba(255,255,255,.15);border-radius:2px;overflow:hidden;animation:splashUp .8s .4s ease both"><div style="width:100%;height:100%;background:#6FB4E4;transform-origin:left;animation:splashBar 1.6s .3s cubic-bezier(.2,.7,.3,1) both"></div></div>
</div>
<% end %>

<div>
  <!-- hero -->
  <div class="sec-pad" style="position:relative;padding:80px 48px 64px;background:radial-gradient(110% 85% at 88% 0%,#E4F0F9 0%,rgba(228,240,249,0) 58%),linear-gradient(180deg,#FDFEFF 0%,#F7FAFC 100%)">
    <div class="m1" style="display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:56px;align-items:center">
      <div style="display:flex;flex-direction:column;gap:28px">
        <div style="display:flex;align-items:center;gap:12px;animation:fadeUp .7s .1s ease both"><svg width="64" height="22" viewBox="0 0 64 22" style="overflow:visible;flex:none"><path d="M0 11 H14 L19 3 L25 19 L30 11 H64" fill="none" stroke="#1273BF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="110" stroke-dashoffset="110" style="animation:ecg 2.8s linear infinite"></path></svg><span style="font-size:12px;letter-spacing:.24em;color:#1273BF"><%= t("home.eyebrow") %></span></div>
        <h1 style="margin:0;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(40px,4.8vw,68px);line-height:1.06;letter-spacing:-.02em;animation:fadeUp .7s .25s ease both"><%= t("home.hero_pre") %><br><span class="hw" id="hero-word" data-words="<%= t('home.hero_words') %>" style="color:#1273BF;display:inline-block"><%= t("home.hero_words").split("|").first %></span><%= t("home.hero_post_html") %></h1>
        <p style="margin:0;max-width:460px;font-size:16.5px;line-height:1.7;color:rgba(22,40,58,.65);animation:fadeUp .7s .4s ease both"><%= t("home.hero_sub") %></p>
        <div style="display:flex;flex-wrap:wrap;gap:14px;animation:fadeUp .7s .55s ease both">
          <a href="<%= contact_path %>" class="btn-hero" style="padding:16px 32px;border-radius:999px;background:#1273BF;color:#fff;font-size:14px;font-weight:700;letter-spacing:.06em;transition:transform .3s,background .3s,box-shadow .3s"><%= t("nav.book") %></a>
          <a href="<%= ApplicationHelper::CLINIC_WHATSAPP_URL %>" target="_blank" rel="noopener" class="btn-wa-outline" style="display:flex;align-items:center;gap:10px;padding:16px 32px;border-radius:999px;border:1.5px solid #25D366;color:#128C4B;font-size:14px;font-weight:700;letter-spacing:.06em;transition:background .3s,color .3s"><svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.5 2 2 6.4 2 11.8c0 1.9.6 3.8 1.6 5.4L2 22l4.9-1.5c1.5.9 3.3 1.3 5.1 1.3 5.5 0 10-4.4 10-9.9S17.5 2 12 2z"></path></svg><%= t("common.whatsapp_us") %></a>
        </div>
        <div style="display:flex;align-items:center;gap:14px;animation:fadeUp .7s .7s ease both">
          <div style="display:flex">
            <span style="width:38px;height:38px;border-radius:50%;background:#DCE9F4;border:2.5px solid #FDFEFF;display:flex;align-items:center;justify-content:center;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:13px;color:#1273BF">A</span>
            <span style="width:38px;height:38px;border-radius:50%;background:#CBE1F2;border:2.5px solid #FDFEFF;margin-left:-10px;display:flex;align-items:center;justify-content:center;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:13px;color:#1273BF">S</span>
            <span style="width:38px;height:38px;border-radius:50%;background:#B7D7EE;border:2.5px solid #FDFEFF;margin-left:-10px;display:flex;align-items:center;justify-content:center;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:13px;color:#0C5A99">F</span>
            <span style="width:38px;height:38px;border-radius:50%;background:#1273BF;border:2.5px solid #FDFEFF;margin-left:-10px;display:flex;align-items:center;justify-content:center;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:11px;color:#fff">2K+</span>
          </div>
          <div style="font-size:13.5px;line-height:1.45;color:rgba(22,40,58,.65)"><span style="color:#F5B942;letter-spacing:1px">★★★★★</span> <%= t("home.rating_html") %></div>
        </div>
      </div>
      <div style="position:relative;animation:fadeIn 1s .3s ease both"><div style="position:absolute;inset:-44px;background:radial-gradient(60% 60% at 50% 50%,rgba(18,115,191,.14),transparent 70%);pointer-events:none;animation:floatY 7s ease-in-out infinite"></div>
        <div class="hero-photo" style="width:100%;height:720px"><img class="slot" src="/images/hero.webp" alt="Dr. Mohammed Ali Balhareth — consultant orthopedic surgeon" style="border-radius:18px"></div>
        <div style="position:absolute;left:18px;bottom:18px;background:rgba(255,255,255,.94);backdrop-filter:blur(8px);border-radius:16px;box-shadow:0 12px 32px rgba(22,40,58,.16);padding:14px 20px;display:flex;align-items:center;gap:12px">
          <span style="width:38px;height:38px;border-radius:12px;background:#E4F0F9;display:flex;align-items:center;justify-content:center;flex:none"><svg width="22" height="14" viewBox="0 0 64 22"><path d="M2 11 H14 L19 3 L25 19 L30 11 H62" fill="none" stroke="#1273BF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
          <div><div style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:14px;color:#16283A"><%= t("home.doctor_chip") %></div><div style="font-size:12px;color:rgba(22,40,58,.6)"><%= t("home.doctor_chip_sub") %></div></div>
        </div>
        <div style="position:absolute;right:-14px;top:26px;background:#fff;border-radius:16px;box-shadow:0 14px 36px rgba(22,40,58,.16);padding:13px 18px;display:flex;align-items:center;gap:11px;animation:floatY 5.5s ease-in-out infinite">
          <span style="width:9px;height:9px;border-radius:50%;background:#25D366;flex:none;animation:pulseRing 2.2s infinite"></span>
          <span style="font-size:13px;font-weight:600;color:#16283A"><%= t("home.accepting") %></span>
        </div>
        <div style="position:absolute;left:-18px;top:120px;background:#fff;border-radius:16px;box-shadow:0 14px 36px rgba(22,40,58,.16);padding:13px 18px;display:flex;align-items:center;gap:11px;animation:floatY 6.5s 1.2s ease-in-out infinite">
          <span style="width:34px;height:34px;border-radius:11px;background:#E4F0F9;display:flex;align-items:center;justify-content:center;font-size:16px;flex:none">🦵</span>
          <div><div style="font-size:13px;font-weight:700;color:#16283A"><%= t("home.walk_weeks") %></div><div style="font-size:11.5px;color:rgba(22,40,58,.6)"><%= t("home.rapid") %></div></div>
        </div>
      </div>
    </div>
    <div class="m2" style="display:grid;grid-template-columns:repeat(4,1fr);border:1px solid rgba(22,40,58,.1);border-radius:18px;overflow:hidden;background:#fff;box-shadow:0 2px 10px rgba(22,40,58,.04);margin-top:64px;animation:fadeUp .7s .7s ease both">
      <div style="padding:26px 30px;border-inline-end:1px solid rgba(22,40,58,.12)"><div style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:36px;color:#1273BF" data-count="7" data-suffix="+">7+</div><div style="font-size:12px;letter-spacing:.14em;color:rgba(22,40,58,.55);margin-top:6px"><%= t("home.stat_years") %></div></div>
      <div style="padding:26px 30px;border-inline-end:1px solid rgba(22,40,58,.12)"><div style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:36px;color:#1273BF" data-count="2000" data-suffix="+">2,000+</div><div style="font-size:12px;letter-spacing:.14em;color:rgba(22,40,58,.55);margin-top:6px"><%= t("home.stat_procs") %></div></div>
      <div style="padding:26px 30px;border-inline-end:1px solid rgba(22,40,58,.12)"><div style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:36px;color:#1273BF" data-count="98" data-suffix="%">98%</div><div style="font-size:12px;letter-spacing:.14em;color:rgba(22,40,58,.55);margin-top:6px"><%= t("home.stat_sat") %></div></div>
      <div style="padding:26px 30px"><div style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:36px;color:#1273BF"><span data-count="4.9" data-decimals="1">4.9</span><span style="font-size:22px">★</span></div><div style="font-size:12px;letter-spacing:.14em;color:rgba(22,40,58,.55);margin-top:6px"><%= t("home.stat_rate") %></div></div>
    </div>
  </div>

  <!-- trust strip -->
  <div class="rv sec-pad" style="padding:26px 48px;display:flex;align-items:center;justify-content:center;gap:14px 56px;flex-wrap:wrap;border-top:1px solid rgba(22,40,58,.08);background:#FDFEFF">
    <span style="font-size:11px;letter-spacing:.2em;color:rgba(22,40,58,.45);flex:none"><%= t("home.certified") %></span>
    <% %w[cred1 cred2 cred3 cred4].each do |k| %>
      <a href="<%= about_path %>" class="link-blue" style="display:flex;align-items:center;gap:10px;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:14px;color:rgba(22,40,58,.6);transition:color .3s"><span style="width:30px;height:30px;border-radius:9px;background:#E4F0F9;display:flex;align-items:center;justify-content:center;color:#1273BF;font-size:13px">✚</span><%= t("home.#{k}") %></a>
    <% end %>
  </div>

  <!-- marquee -->
  <div style="border-top:1px solid rgba(22,40,58,.1);border-bottom:1px solid rgba(22,40,58,.1);overflow:hidden;padding:14px 0;white-space:nowrap;background:#EAF2F8">
    <div style="display:inline-flex;animation:marquee 20s linear infinite">
      <% 2.times do %>
        <span style="display:inline-flex;gap:40px;padding-inline-end:40px;font-size:13px;letter-spacing:.2em;color:rgba(22,40,58,.5)"><% t("home.marquee").split("|").each do |item| %><span><%= item %></span><span style="color:#1273BF">✚</span><% end %></span>
      <% end %>
    </div>
  </div>

  <!-- about strip -->
  <div class="rv m1 sec-pad" style="padding:88px 48px;display:grid;grid-template-columns:minmax(0,.4fr) minmax(0,.6fr);gap:56px">
    <div>
      <div style="font-size:12px;letter-spacing:.24em;color:#1273BF;margin-bottom:18px"><%= t("home.about_label") %></div>
      <h2 style="margin:0;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:40px;line-height:1.05;text-transform:uppercase"><%= t("home.about_heading_html") %></h2>
      <a href="<%= about_path %>" style="display:inline-block;margin-top:26px;font-size:13px;letter-spacing:.1em;color:#1273BF;border-bottom:1px solid #1273BF;padding-bottom:2px"><%= t("home.full_profile") %></a>
    </div>
    <div style="display:flex;flex-direction:column;gap:24px">
      <p style="margin:0;font-size:17px;line-height:1.75;color:rgba(22,40,58,.75)"><%= t("home.about_para") %></p>
      <div class="m1" style="display:grid;grid-template-columns:1fr 1fr;gap:1px;background:rgba(22,40,58,.1);border:1px solid rgba(22,40,58,.1);border-radius:18px;overflow:hidden;box-shadow:0 2px 10px rgba(22,40,58,.04)">
        <% %w[training cert trauma academia].each do |k| %>
          <div class="cell-tint" style="background:#F7FAFC;padding:22px 24px;transition:background .3s"><div style="font-size:12px;letter-spacing:.16em;color:#1273BF;margin-bottom:8px"><%= t("home.grid_#{k}") %></div><div style="font-size:14.5px;line-height:1.5"><%= t("home.grid_#{k}_v") %></div></div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- specialties (dashboard-managed operations) -->
  <% if @operations.any? %>
  <div class="sec-pad" style="padding:0 48px 88px">
    <div style="font-size:12px;letter-spacing:.24em;color:#1273BF;margin-bottom:18px"><%= t("home.specialties_label") %></div>
    <div class="rv-kids m2" style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px">
      <% @operations.each_with_index do |operation, i| %>
      <a href="<%= specialty_path(loc_slug(operation)) %>" class="card-spec" style="position:relative;height:420px;border-radius:18px;overflow:hidden;box-shadow:0 4px 16px rgba(22,40,58,.08);display:block;transition:transform .35s,box-shadow .35s;background:#0F2436">
        <% if (photo_url = operation_photo_url(operation, landing: true)) %>
          <img class="slot" src="<%= photo_url %>" alt="<%= loc(operation, :image_alt_text).presence || loc(operation, :title) %>" style="height:420px;border-radius:18px">
        <% end %>
        <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(11,36,56,0) 30%,rgba(11,36,56,.55) 60%,rgba(11,36,56,.92) 100%);pointer-events:none"></div>
        <div style="position:absolute;left:0;right:0;bottom:0;padding:26px 26px 24px;color:#fff;pointer-events:none;display:flex;flex-direction:column;gap:10px">
          <span style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:15px;color:rgba(255,255,255,.55)"><%= format('%02d', i + 1) %></span>
          <span style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(15px,1.5vw,22px);line-height:1.1;text-transform:uppercase;overflow-wrap:anywhere"><%= loc(operation, :title) %></span>
          <span style="font-size:13.5px;line-height:1.6;color:rgba(255,255,255,.82)"><%= loc(operation, :description).to_s.truncate(95) %></span>
          <span style="font-size:12px;letter-spacing:.14em;color:#8FC6EC;margin-top:4px"><%= t("common.read_guide") %></span>
        </div>
      </a>
      <% end %>
    </div>
  </div>
  <% end %>

  <!-- why -->
  <div class="rv m1 sec-pad" style="padding:0 48px 88px;display:grid;grid-template-columns:minmax(0,.4fr) minmax(0,.6fr);gap:56px">
    <div>
      <div style="font-size:12px;letter-spacing:.24em;color:#1273BF;margin-bottom:18px"><%= t("home.why_label") %></div>
      <h2 style="margin:0;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:40px;line-height:1.05;text-transform:uppercase"><%= t("home.why_heading_html") %></h2>
    </div>
    <div class="m1" style="display:grid;grid-template-columns:1fr 1fr;gap:20px">
      <% %w[why1 why2 why3 why4].each do |k| %>
      <div class="card-line" style="border:1px solid rgba(22,40,58,.1);border-radius:16px;background:#fff;box-shadow:0 2px 10px rgba(22,40,58,.04);padding:26px;transition:border-color .3s,transform .3s"><div style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:15px;letter-spacing:.08em;color:#1273BF;margin-bottom:10px"><%= t("home.#{k}") %></div><div style="font-size:14.5px;line-height:1.65;color:rgba(22,40,58,.65)"><%= t("home.#{k}_v") %></div></div>
      <% end %>
    </div>
  </div>

  <!-- journey -->
  <div class="sec-pad" style="padding:0 48px 88px">
    <div style="font-size:12px;letter-spacing:.24em;color:#1273BF;margin-bottom:18px"><%= t("home.journey_label") %></div>
    <div class="rv-kids m1" style="display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:rgba(22,40,58,.1);border:1px solid rgba(22,40,58,.1);border-radius:18px;overflow:hidden;box-shadow:0 2px 10px rgba(22,40,58,.04)">
      <% %w[j1 j2 j3 j4].each_with_index do |k, i| %>
      <div style="background:#F7FAFC;padding:28px 24px"><div style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:30px;color:#1273BF;margin-bottom:14px"><%= i + 1 %></div><div style="font-weight:700;font-size:15px;letter-spacing:.04em;margin-bottom:8px"><%= t("home.#{k}") %></div><div style="font-size:13px;line-height:1.6;color:rgba(22,40,58,.55)"><%= t("home.#{k}_v") %></div></div>
      <% end %>
      <div style="background:#F7FAFC;padding:28px 24px"><div style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:30px;color:#1273BF;margin-bottom:14px">5</div><div style="font-weight:700;font-size:15px;letter-spacing:.04em;margin-bottom:8px"><%= t("home.j5") %></div><div style="font-size:13px;line-height:1.6;color:rgba(22,40,58,.55)"><%= t("home.j5_v") %></div></div>
    </div>
  </div>

  <%# Sections hidden at the client's request (July 2026):
      OUTCOMES — awaiting real, permission-cleared patient testimonials. %>

  <!-- latest articles (shows once real articles are published) -->
  <% if @latest_blogs.any? %>
  <div class="rv sec-pad" style="padding:0 48px 88px">
    <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:24px">
      <div style="font-size:12px;letter-spacing:.24em;color:#1273BF"><%= t("home.articles_label") %></div>
      <a href="<%= articles_path %>" class="link-blue" style="font-size:13px;letter-spacing:.1em;color:rgba(22,40,58,.6);border-bottom:1px solid rgba(22,40,58,.3);padding-bottom:2px;transition:color .3s"><%= t("home.articles_all") %></a>
    </div>
    <div class="rv-kids m2" style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px">
      <% @latest_blogs.each do |blog| %>
      <a href="<%= article_path(loc_slug(blog)) %>" class="card-line" style="border:1px solid rgba(22,40,58,.1);border-radius:18px;overflow:hidden;background:#fff;box-shadow:0 2px 10px rgba(22,40,58,.04);display:block;transition:border-color .3s,transform .3s">
        <% if (photo_url = blog_photo_url(blog)) %>
          <div style="height:150px"><img class="slot" src="<%= photo_url %>" alt="<%= loc(blog, :image_alt_text).presence || loc(blog, :title) %>" style="height:150px;border-radius:0"></div>
        <% end %>
        <div style="padding:22px 24px">
          <div style="font-size:11.5px;letter-spacing:.18em;color:#1273BF;margin-bottom:10px"><%= blog.category ? t("articles.categories.#{blog.category}", default: blog.category.to_s.upcase) : t("articles.categories.general") %></div>
          <div style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:18px;line-height:1.35;color:#16283A"><%= loc(blog, :title) %></div>
        </div>
      </a>
      <% end %>
    </div>
  </div>
  <% end %>

  <!-- booking CTA -->
  <div class="rv m1 sec-pad" style="border-top:1px solid rgba(22,40,58,.12);padding:88px 48px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:64px;background:radial-gradient(110% 85% at 12% 100%,#E4F0F9 0%,rgba(228,240,249,0) 58%),linear-gradient(0deg,#FDFEFF 0%,#F7FAFC 100%)">
    <div style="display:flex;flex-direction:column;gap:24px;justify-content:center">
      <div style="font-size:12px;letter-spacing:.24em;color:#1273BF"><%= t("home.contact_label") %></div>
      <h2 style="margin:0;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(32px,4vw,52px);line-height:1;text-transform:uppercase"><%= t("home.contact_heading_html") %></h2>
      <div style="display:flex;flex-direction:column;gap:12px;font-size:15px;color:rgba(22,40,58,.75)">
        <a href="<%= ApplicationHelper::CLINIC_MAP_LINK %>" target="_blank" rel="noopener" class="link-blue" style="transition:color .3s"><%= t("home.contact_location") %></a>
        <a href="<%= ApplicationHelper::CLINIC_WHATSAPP_URL %>" target="_blank" rel="noopener" class="link-blue" style="transition:color .3s">📞 <span style="direction:ltr;unicode-bidi:embed"><%= ApplicationHelper::CLINIC_PHONE_DISPLAY %></span></a>
        <span><%= t("home.contact_hours") %></span>
      </div>
      <a href="<%= ApplicationHelper::CLINIC_WHATSAPP_URL %>" target="_blank" rel="noopener" class="lift-2" style="align-self:flex-start;display:flex;align-items:center;gap:12px;background:#25D366;color:#0B1A12;border-radius:999px;padding:15px 30px;font-size:14px;font-weight:700;letter-spacing:.06em;animation:pulseRing 2.4s infinite;transition:transform .3s"><%= t("common.whatsapp_clinic") %></a>
    </div>
    <%= render "shared/booking_form", compact: true %>
  </div>
</div>
