<%# locals: q, a %>
<details class="faq-d" style="border:1px solid rgba(22,40,58,.1);border-radius:14px;background:#fff;overflow:hidden;transition:border-color .3s,box-shadow .3s">
  <summary style="cursor:pointer;list-style:none;padding:22px 26px;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:16.5px;display:flex;justify-content:space-between;align-items:center;gap:16px"><%= q %><span class="pl" style="color:#1273BF;font-size:20px;flex:none;display:inline-block">+</span></summary>
  <div style="padding:0 26px 24px;font-size:15px;line-height:1.7;color:rgba(22,40,58,.65)"><%= a %></div>
</details>
