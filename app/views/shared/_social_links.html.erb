<%# The doctor's social profiles as circular icon links.
    locals: dark (bool) — dark variant for the footer, light for pages. %>
<% dark = local_assigns.fetch(:dark, false) %>
<%
  icons = {
    instagram: '<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.2" cy="6.8" r="1.3" fill="currentColor"/>',
    x: '<path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>',
    tiktok: '<path fill="currentColor" d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 1 1-2.59-2.59c.27 0 .53.04.77.13v-3.13a5.7 5.7 0 0 0-.77-.05 5.66 5.66 0 1 0 5.66 5.66V8.73a7.35 7.35 0 0 0 4.3 1.38V7.02a4.28 4.28 0 0 1-3.22-1.2z"/>',
    snapchat: '<path fill="currentColor" d="M12 2.5c-3.6 0-6.2 2.7-6.2 6.2v3.1c-.7.5-1.9.7-2.6.8-.4.1-.5.6-.2.9.6.6 1.7 1.1 2.5 1.3-.1.5-.6 1.1-1.7 1.5-.4.1-.4.7 0 .9.9.4 2 .6 2.8.7.3.7 1 1.9 2.4 1.9.9 0 1.3-.4 3-.4s2.1.4 3 .4c1.4 0 2.1-1.2 2.4-1.9.8-.1 1.9-.3 2.8-.7.4-.2.4-.8 0-.9-1.1-.4-1.6-1-1.7-1.5.8-.2 1.9-.7 2.5-1.3.3-.3.2-.8-.2-.9-.7-.1-1.9-.3-2.6-.8V8.7c0-3.5-2.6-6.2-6.2-6.2z"/>',
    facebook: '<path fill="currentColor" d="M13.5 21.5v-7.4h2.49l.37-2.89H13.5V9.36c0-.84.23-1.41 1.44-1.41h1.53V5.36c-.26-.04-1.17-.11-2.23-.11-2.21 0-3.72 1.35-3.72 3.82v2.14H8.02v2.89h2.5v7.4z"/>'
  }
%>
<div style="display:flex;gap:10px;flex-wrap:wrap">
  <% ApplicationHelper::SOCIAL_LINKS.each do |name, url| %>
    <a href="<%= url %>" target="_blank" rel="noopener" aria-label="<%= name.to_s.capitalize %>" class="social-ic <%= 'social-ic-dark' if dark %>">
      <svg width="18" height="18" viewBox="0 0 24 24"><%= raw icons[name] %></svg>
    </a>
  <% end %>
</div>
