<div id="site-nav" style="position:sticky;top:0;z-index:50;display:flex;align-items:center;justify-content:space-between;gap:28px;padding:0 32px;min-height:68px;border-bottom:1px solid rgba(22,40,58,.1);background:rgba(255,255,255,.92);backdrop-filter:blur(10px);transition:box-shadow .4s">
  <a href="<%= root_path %>" style="display:flex;align-items:center;gap:10px;white-space:nowrap">
    <span style="width:34px;height:34px;border-radius:10px;background:#1273BF;display:flex;align-items:center;justify-content:center;flex:none"><svg width="20" height="16" viewBox="0 0 64 22"><path d="M2 11 H14 L19 3 L25 19 L30 11 H62" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
    <span style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:17px;letter-spacing:.04em;color:#16283A">DR-BALHARETH<span style="color:#1273BF">.</span>ORTHO</span>
  </a>
  <div style="display:flex;flex-wrap:wrap;gap:10px 24px;justify-content:center;font-size:13.5px;letter-spacing:.06em;color:rgba(22,40,58,.7);align-items:center">
    <a href="<%= root_path %>" class="<%= nav_link_class(root_path) %>"><%= t("nav.home") %></a>
    <a href="<%= about_path %>" class="<%= nav_link_class(about_path) %>"><%= t("nav.about") %></a>
    <span class="nav-drop">
      <a href="<%= specialties_path %>" class="<%= nav_link_class(specialties_path) %>"><%= t("nav.specialties") %> <span style="font-size:9px;vertical-align:2px">▼</span></a>
      <span class="nav-drop-menu">
        <% Operation.published.reorder(:id).each do |operation| %>
          <a href="<%= specialty_path(loc_slug(operation)) %>"><%= loc(operation, :title) %></a>
        <% end %>
      </span>
    </span>
    <% if show_articles_nav? %>
      <a href="<%= articles_path %>" class="<%= nav_link_class(articles_path) %>"><%= t("nav.articles") %></a>
    <% end %>
    <a href="<%= faq_path %>" class="<%= nav_link_class(faq_path) %>"><%= t("nav.faq") %></a>
    <a href="<%= contact_path %>" class="<%= nav_link_class(contact_path) %>"><%= t("nav.contact") %></a>
  </div>
  <div style="display:flex;align-items:center;gap:14px">
    <a href="<%= locale_switch_path %>" class="lang-switch" style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:13px;letter-spacing:.04em;color:#1273BF;border:1px solid rgba(18,115,191,.4);border-radius:999px;padding:8px 16px;white-space:nowrap;transition:background .3s,color .3s"><%= rtl? ? "English" : "العربية" %></a>
    <a href="<%= ApplicationHelper::CLINIC_WHATSAPP_URL %>" target="_blank" rel="noopener" class="btn-blue" style="padding:11px 24px;border-radius:999px;background:#1273BF;color:#fff;font-size:13px;font-weight:700;letter-spacing:.08em;white-space:nowrap;transition:background .3s"><%= t("nav.book") %></a>
  </div>
</div>
